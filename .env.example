# Copy to .env and adjust for your machine.
DATABASE_URL=postgres://fleetpulse:fleetpulse@localhost:5432/fleetpulse
BIND_ADDR=0.0.0.0:8080
RUST_LOG=fleetpulse=debug,tower_http=info,sqlx=warn

# Operator endpoints use a static key in v1 (ADR-013).
OPERATOR_API_KEY=dev-operator-key

# Queries currently use sqlx's runtime query functions, so a live database is
# not needed at build time and SQLX_OFFLINE is not used. See docs/TECH_STACK.md.
